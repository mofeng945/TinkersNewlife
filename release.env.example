# 复制本文件为 release.env，填上自己的值，然后就能一条命令发版了。
# ⚠ release.env 已在 .gitignore 里（不会被提交，Token 不会泄漏）；本示例文件可以提交。
#
# 用法：powershell -ExecutionPolicy Bypass -File tools\release.ps1
#   （= 构建 → 部署到本地测试实例 → 上传 Modrinth）
# 也可以只用上传：powershell -ExecutionPolicy Bypass -File upload-modrinth.ps1 -DryRun

# Modrinth 个人访问令牌：https://modrinth.com/settings/pats
# 需要勾选 "Versions" 的 "Create version"（以及 "Read projects"）权限
MODRINTH_TOKEN=

# 项目 slug 或 ID：就是项目页 URL 里 modrinth.com/mod/<这一串>
MODRINTH_PROJECT=
